# Bind to the NAS private LAN IP to allow household devices.
HOMEBOARD_BIND_IP=127.0.0.1
HOMEBOARD_PORT=8091
WALKING_MINUTES=1
DRESSING_MINUTES=10
SHOES_MINUTES=3

# Transport supports ideska (reported delay with scheduled fallback), comett, mock, or disabled.
# School: mock, disabled, bakalari. Calendar: mock, disabled, google_ics.
# Run scripts/setup_bakalari.py for protected local school credentials.
TRANSPORT_SOURCE=ideska
SCHOOL_SOURCE=bakalari
CALENDAR_SOURCE=google_ics

# Run scripts/setup_calendar.py for private Google iCal feeds, then start_homeboard.py.
